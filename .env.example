# Local development only. Do NOT commit a filled-in .env.
#
# Open-Meteo requires no API key, so there is nothing secret here by default.

NWS_API_BASE_URL=https://api.weather.gov
NWS_USER_AGENT=weather-mcp-agent (you@example.com)

# Local server port (Databricks Apps sets DATABRICKS_APP_PORT itself).
PORT=8000
